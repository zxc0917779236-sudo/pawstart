function buildPrompt(a, rule){
  return `你是寵物用品門市的「飼養適配評估」助理，對象是準備帶貓狗回家的新手飼主。請用台灣繁體中文，語氣溫暖但誠實，重點放在「準備度」而不是評斷飼主。不可推薦任何品牌或特定商品，清單只寫品類。不做醫療診斷。

飼主資料：
${profileText(a)}

規則引擎參考分數（0–100，越高越適配）：
${rule.dimensions.map(d=>`${d.name}：${d.score}`).join("\n")}

請以參考分數為基礎，考慮品種或類型的特性（例如運動量、體型、是否需要大量陪伴）做合理調整，每個面向調整幅度不超過 15 分。

只回傳 JSON，不要任何其他文字或 Markdown，格式如下：
{"score":整數0-100,"summary":"一句話總結，40字內","dimensions":[{"name":"時間陪伴","score":整數,"comment":"20字內"},{"name":"居住環境","score":整數,"comment":"20字內"},{"name":"經濟準備","score":整數,"comment":"20字內"},{"name":"家庭共識","score":整數,"comment":"20字內"},{"name":"經驗與變動","score":整數,"comment":"20字內"}],"risks":[{"title":"10字內","reason":"60字內，具體說明飼主條件與毛孩需求的落差"}],"suggestions":["具體可行的建議，45字內"],"checklist":[{"category":"飲食|居家|外出|清潔|醫療與登記|陪伴與訓練","items":["品類名稱"]}],"costs":[{"item":"飲食|醫療與預防|用品|美容與訓練","low":整數新台幣,"high":整數新台幣,"note":"15字內"}]}

規則：risks 最多 3 項、依嚴重度排序，分數都在 75 以上時可以只給 1 項或空陣列；suggestions 3–4 項；checklist 4–6 類、每類 2–4 項，依種類、年齡與居住條件個人化；costs 為第一年粗估區間。score 為五個面向的平均。`;
}
function normalize(o, rule){
  if (!o || typeof o!=="object") return null;
  const dims = DIMS.map((n,i)=>{
    const d = Array.isArray(o.dimensions) ? o.dimensions.find(x=>x&&x.name===n) : null;
    return {name:n, score: d && Number.isFinite(+d.score) ? clamp(+d.score,0,100) : rule.dimensions[i].score, comment: d && typeof d.comment==="string" ? d.comment : rule.dimensions[i].comment};
  });
  const score = clamp(dims.reduce((s,d)=>s+d.score,0)/dims.length,0,100);
  const strs = (x)=>Array.isArray(x)?x.filter(s=>typeof s==="string"&&s.trim()):[];
  const risks = Array.isArray(o.risks) ? o.risks.filter(r=>r&&typeof r.title==="string").slice(0,3).map(r=>({title:r.title,reason:String(r.reason||"")})) : rule.risks;
  const sugg = strs(o.suggestions).slice(0,4);
  const checklist = Array.isArray(o.checklist) ? o.checklist.filter(c=>c&&typeof c.category==="string").map(c=>({category:c.category,items:strs(c.items).slice(0,5)})).filter(c=>c.items.length) : [];
  const costs = Array.isArray(o.costs) ? o.costs.filter(c=>c&&typeof c.item==="string"&&Number.isFinite(+c.low)&&Number.isFinite(+c.high)).map(c=>({item:c.item,low:Math.max(0,Math.round(+c.low)),high:Math.max(0,Math.round(+c.high)),note:String(c.note||"")})) : [];
  return {score, level:levelOf(score), summary: typeof o.summary==="string" ? o.summary : rule.summary, dimensions:dims, risks,
    suggestions: sugg.length ? sugg : rule.suggestions, checklist: checklist.length ? checklist : rule.checklist, costs: costs.length ? costs : rule.costs, costsIllustrative: !costs.length};
}
