  p.append(el("h2",{text:"關懷陪伴模擬"}), el("p",{class:"muted",text:"模擬飼主帶毛孩回家後收到的 LINE 關懷訊息。選擇天數，再以飼主身分回覆，看看系統如何判讀風險。"}));
  const days = el("div",{class:"days",role:"group","aria-label":"關懷時點"});
  [7,30,90].forEach(d=>days.append(el("button",{type:"button",class:"chip","aria-pressed":chatDay===d?"true":"false",onclick:()=>{chatDay=d;chat=[{who:"bot",text:CHECKINS[d]}];renderResult();}},`第 ${d} 天`)));
  p.append(days);
  const box = el("div",{class:"chat"});
  if (!chatDay) box.append(el("p",{class:"muted",style:"margin:auto;text-align:center",text:"先選擇要模擬的天數"}));
  chat.forEach(m=>{
    if (m.who==="sys"){
      const j = m.j;
      box.append(el("div",{class:"sys"},
        el("span",{class:"tagline",text:"系統端判讀（飼主看不到）"}),
        el("div",{}, el("b",{text:"風險等級："}), el("span",{style:`color:${j.level==="低風險"?"var(--low)":j.level==="中風險"?"var(--mid)":"var(--high)"};font-weight:700`,text:j.level})),
        j.signals.length ? el("div",{}, el("b",{text:"判讀訊號："}), j.signals.join("、")) : null,
        el("div",{}, el("b",{text:"後續行動："}), j.referral || "持續定期關懷")
      ));
    } else box.append(el("div",{class:"msg "+m.who}, m.who==="bot"?el("span",{class:"who",text:"PawStart"}):null, m.text));
  });
  if (chatBusy) box.append(el("div",{class:"msg bot"}, el("span",{class:"who",text:"PawStart"}), "判讀中…"));
  p.append(box);
  if (chatDay){
    const q = el("div",{class:"quick"});
    QUICK.forEach(t=>q.append(el("button",{type:"button",class:"chip",disabled:chatBusy,onclick:()=>sendReply(t)},t)));
    const inp = el("input",{type:"text",placeholder:"以飼主身分輸入回覆",maxlength:"120","aria-label":"飼主回覆"});
    const send = el("button",{class:"btn",disabled:chatBusy,onclick:()=>sendReply(inp.value.trim())},"送出");
    inp.addEventListener("keydown",e=>{ if(e.key==="Enter" && !e.isComposing) sendReply(inp.value.trim()); });
    p.append(el("div",{class:"muted",style:"margin-top:12px",text:"快速回覆範例："}), q, el("div",{class:"composer"}, inp, send));
  }
}

renderWelcome();
})();
</script>
