<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PawStart 毛孩好起點｜飼養適配評估原型</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap">
<style>
:root{
  --bg:#E8EEEA;--surface:#FBFCFA;--surface2:#F0F4F1;--ink:#17312F;--body:#3B504E;--muted:#5D6E6B;
  --line:#D2DCD7;--brand:#1F4A45;--brandInk:#F4F8F6;--amber:#E39B45;--amberInk:#2A1A06;
  --low:#2A7362;--mid:#A3600F;--high:#A9361F;--chip:#E1EAE5;--chipOn:#1F4A45;--chipOnInk:#F4F8F6;
  --chatbg:#DAE5DF;--bot:#FFFFFF;--me:#CDEAD7;--sys:#FFF6EA;--sysLine:#E9C79A;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1918;--surface:#162523;--surface2:#1C2D2B;--ink:#E6EFEB;--body:#C2D2CD;--muted:#94A6A1;
    --line:#2B3F3C;--brand:#8FCFC2;--brandInk:#0E1918;--amber:#E9AA5E;--amberInk:#2A1A06;
    --low:#6CC4AE;--mid:#E6A650;--high:#F2836E;--chip:#213532;--chipOn:#8FCFC2;--chipOnInk:#0E1918;
    --chatbg:#111F1D;--bot:#203230;--me:#2A5243;--sys:#2B2418;--sysLine:#6E5530;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1918;--surface:#162523;--surface2:#1C2D2B;--ink:#E6EFEB;--body:#C2D2CD;--muted:#94A6A1;
  --line:#2B3F3C;--brand:#8FCFC2;--brandInk:#0E1918;--amber:#E9AA5E;--amberInk:#2A1A06;
  --low:#6CC4AE;--mid:#E6A650;--high:#F2836E;--chip:#213532;--chipOn:#8FCFC2;--chipOnInk:#0E1918;
  --chatbg:#111F1D;--bot:#203230;--me:#2A5243;--sys:#2B2418;--sysLine:#6E5530;
  color-scheme:dark;
}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--ink);font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,sans-serif;font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--brand)}
button{font:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--amber);outline-offset:2px}

header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--brand);color:var(--brandInk)}
.bar{max-width:520px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:12px}
.logo{font-weight:900;font-size:20px;letter-spacing:.01em}
.logo small{font-weight:500;font-size:14px;margin-left:6px;opacity:.85}
.mode{margin-left:auto;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px;background:var(--amber);color:var(--amberInk)}

main{max-width:520px;margin:0 auto;padding:20px 16px 40px}
.panel{background:var(--surface);border-radius:22px;padding:24px 22px;border:1px solid var(--line)}
h1{font-size:30px;line-height:1.3;margin:0 0 12px;font-weight:900}
h2{font-size:22px;line-height:1.35;margin:0 0 6px;font-weight:900}
h3{font-size:17px;margin:0 0 8px;font-weight:700}
p{margin:0 0 12px;color:var(--body)}
.muted{color:var(--muted);font-size:14px}
.btn{display:block;width:100%;border:0;border-radius:14px;padding:14px 18px;font-weight:700;font-size:17px;background:var(--brand);color:var(--brandInk)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--brand);border:2px solid var(--brand)}
.row{display:flex;gap:10px}
.row .btn{flex:1}

.hero-paw{font-size:44px;line-height:1;margin-bottom:12px}
.promises{list-style:none;padding:0;margin:18px 0 22px;display:grid;gap:10px}
.promises li{background:var(--surface2);border-radius:14px;padding:12px 14px;color:var(--body);font-size:15px}
.promises b{color:var(--ink)}

.progress{height:8px;border-radius:99px;background:var(--chip);overflow:hidden;margin:4px 0 18px}
.progress span{display:block;height:100%;background:var(--amber);border-radius:99px;transition:width .3s ease}
.stepno{font-size:13px;font-weight:700;color:var(--muted);margin-bottom:4px}
.field{margin:18px 0 0}
.field label,.field .lab{display:block;font-weight:700;font-size:15px;margin-bottom:8px;color:var(--ink)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1.5px solid var(--line);background:var(--chip);color:var(--ink);border-radius:999px;padding:8px 14px;font-size:15px;line-height:1.3}
.chip[aria-pressed="true"]{background:var(--chipOn);color:var(--chipOnInk);border-color:var(--chipOn);font-weight:700}
input[type=text],textarea{width:100%;border:1.5px solid var(--line);background:var(--surface2);color:var(--ink);border-radius:12px;padding:11px 14px;font:inherit}
.nav{margin-top:26px}

.loading{text-align:center;padding:48px 22px}
.dots{display:inline-flex;gap:8px;margin:12px 0 18px}
.dots i{width:12px;height:12px;border-radius:50%;background:var(--amber);animation:b 1s infinite ease-in-out}
.dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}
@keyframes b{0%,80%,100%{transform:scale(.5);opacity:.4}40%{transform:scale(1);opacity:1}}

.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:4px;margin-bottom:14px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 52px);z-index:4}
.tab{border:0;background:transparent;color:var(--muted);border-radius:10px;padding:9px 4px;font-size:14px;font-weight:700}
.tab[aria-selected="true"]{background:var(--brand);color:var(--brandInk)}

.scorebox{display:flex;gap:18px;align-items:center}
.ring{flex:none;width:118px;height:118px;position:relative}
.ring svg{width:118px;height:118px;transform:rotate(-90deg)}
.ring .val{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .val b{font-size:34px;line-height:1;font-weight:900}
.ring .val span{font-size:12px;color:var(--muted)}
.level{display:inline-block;font-weight:900;font-size:15px;padding:3px 12px;border-radius:999px;margin-bottom:8px;color:#fff}
.lv-low{background:var(--low)}.lv-mid{background:var(--mid)}.lv-high{background:var(--high)}
:root[data-theme="dark"] .level{color:#0E1918}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .level{color:#0E1918}}
.dims{display:grid;gap:12px;margin-top:18px}
.dim .top{display:flex;justify-content:space-between;font-size:14px;font-weight:700}
.dim .top span:last-child{color:var(--muted);font-weight:500}
.meter{height:10px;border-radius:99px;background:var(--chip);overflow:hidden;margin:5px 0 3px}
.meter span{display:block;height:100%;border-radius:99px}
.dim small{color:var(--muted);font-size:13px}
.sect{margin-top:16px}
.risk{border-left:5px solid var(--high);background:var(--surface2);border-radius:12px;padding:12px 14px;margin-top:10px}
.risk h3{margin-bottom:4px}
.risk p{margin:0;font-size:15px}
.sugg{margin:8px 0 0;padding-left:20px;color:var(--body)}
.sugg li{margin:6px 0}

.cat{margin-top:12px;background:var(--surface2);border-radius:14px;padding:14px}
.cat ul{margin:6px 0 0;padding:0;list-style:none;display:grid;gap:6px}
.cat li label{display:flex;gap:10px;align-items:flex-start;font-size:15px;color:var(--body)}
.cat input{margin-top:5px;width:18px;height:18px;accent-color:var(--brand)}

table{width:100%;border-collapse:collapse;margin-top:10px;font-size:15px}
th,td{text-align:left;padding:10px 6px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:13px;color:var(--muted)}
td.n{white-space:nowrap;font-weight:700;color:var(--ink)}
td small{color:var(--muted)}
.budget{margin-top:16px;border-radius:14px;padding:14px;background:var(--surface2)}
.budget .verdict{font-weight:700;margin:6px 0 0}

.chat{background:var(--chatbg);border-radius:18px;padding:14px;min-height:260px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:84%;padding:10px 13px;border-radius:16px;font-size:15px;line-height:1.55;white-space:pre-wrap}
.msg.bot{background:var(--bot);color:var(--ink);border-top-left-radius:4px;align-self:flex-start}
.msg.me{background:var(--me);color:var(--ink);border-top-right-radius:4px;align-self:flex-end}
.msg .who{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:2px}
.sys{align-self:stretch;background:var(--sys);border:1.5px dashed var(--sysLine);border-radius:14px;padding:10px 13px;font-size:14px;color:var(--body)}
.sys b{color:var(--ink)}
.sys .tagline{font-size:12px;font-weight:700;color:var(--muted);display:block;margin-bottom:4px}
.days{display:flex;gap:8px;margin:12px 0}
.days .chip{flex:1;text-align:center}
.quick{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.quick .chip{font-size:13px;padding:6px 11px}
.composer{display:flex;gap:8px;margin-top:8px}
.composer input{flex:1}
.composer .btn{width:auto;padding:10px 16px;font-size:15px}
.foot{margin-top:18px;font-size:12px;color:var(--muted);text-align:center}
.err{color:var(--high);font-size:14px;margin-top:8px}
.notice{background:var(--surface2);border-left:5px solid var(--amber);border-radius:12px;padding:10px 14px;font-size:14px;color:var(--body);margin:0 0 16px}
</style>
</head>
<body>
<header><div class="bar"><div class="logo">PawStart<small>毛孩好起點</small></div><span class="mode" id="mode">公開示範版</span></div></header>
<main id="app" aria-live="polite"></main>

<script>
(function(){
"use strict";
const STEPS = [
  {title:"想養的毛孩", hint:"先說說你想帶回家的是誰。", fields:[
    {k:"species", label:"種類", type:"single", opts:["狗","貓"]},
    {k:"breed", label:"品種或類型（選填）", type:"text", ph:"例：柴犬、米克斯、還沒決定"},
    {k:"age", label:"年齡", type:"single", opts:["幼年（1 歲以下）","成年","高齡（7 歲以上）"]}
  ]},
  {title:"居住環境", hint:"住的地方，決定毛孩能不能安穩待下來。", fields:[
    {k:"housing", label:"目前住處", type:"single", opts:["租屋","自有住宅","與家人同住"]},
    {k:"space", label:"空間大小", type:"single", opts:["套房","公寓","有庭院的透天"]},
    {k:"landlord", label:"房東或家人同意養嗎？", type:"single", opts:["已經同意","還沒確認","不需要詢問"]}
  ]},
  {title:"時間與陪伴", hint:"照實回答就好，這不是考試。", fields:[
    {k:"companion", label:"每天能專心陪伴的時間", type:"single", opts:["不到 1 小時","1–3 小時","3 小時以上"]},
    {k:"away", label:"平日家裡沒人的時間", type:"single", opts:["6 小時以內","6–10 小時","10 小時以上"]}
  ]},
  {title:"經濟準備", hint:"第一年通常是花費最多的一年。", fields:[
    {k:"monthly", label:"每月願意為毛孩花費", type:"single", opts:["2,000 元以下","2,000–4,000 元","4,000 元以上"]},
    {k:"emergency", label:"有沒有緊急醫療預備金？", type:"single", opts:["有，至少 1 萬元","還沒有"]}
  ]},
  {title:"家庭成員", hint:"一起住的人，都會是毛孩的家人。", fields:[
    {k:"members", label:"同住成員（可複選）", type:"multi", opts:["獨居","伴侶或室友","幼兒","長輩","其他寵物"], excl:["獨居"]},
    {k:"consent", label:"大家都同意養嗎？", type:"single", opts:["大家都同意","還有人不確定"]},
    {k:"allergy", label:"家中有人對貓狗過敏嗎？", type:"single", opts:["沒有","有","不確定"]}
  ]},
  {title:"經驗與未來規劃", hint:"毛孩會陪你 10 年以上，想想接下來的生活。", fields:[
    {k:"experience", label:"飼養經驗", type:"single", opts:["第一次養","以前養過"]},
    {k:"changes", label:"未來一年可能的生活變動（可複選）", type:"multi", opts:["搬家","結婚或新生兒","換工作","出國或長期外派","都沒有"], excl:["都沒有"]}
  ]}
];
const DIMS = ["時間陪伴","居住環境","經濟準備","家庭共識","經驗與變動"];
const CHECKINS = {
  7:"嗨！毛孩來家裡一週了 🐾\n吃飯、睡覺、上廁所都還順利嗎？有沒有讓你頭痛的地方？",
  30:"一個月了！這段時間的花費，跟你原本預期的差不多嗎？\n毛孩有沒有出現吠叫、破壞或亂尿尿的狀況？",
  90:"三個月了，最近生活有什麼變化嗎？例如工作、住處或家裡成員。\n毛孩跟大家相處得如何？"
};
const QUICK = ["都很順利，牠很快就適應了","牠白天一直叫，鄰居來抗議了","下個月要搬家，新房東不讓養","開銷比想像多很多，有點吃不消"];

const app = document.getElementById("app");
const modeEl = document.getElementById("mode");
let A = {members:[], changes:[]};
let step = -1, tab = "result", result = null, usedAI = false;
let chat = [], chatDay = null, chatBusy = false;
let sample = null, aiBlocked = false;

if (window.claude && typeof window.claude.use === "function") {
  window.claude.use("sample").then(s => { sample = s; setMode(); }).catch(() => {});
}
function setMode(){
  if (result) modeEl.textContent = usedAI ? "AI 判讀" : "規則示範模式";
  else modeEl.textContent = (sample && !aiBlocked) ? "AI 已連線" : "公開示範版";
}
function el(tag, attrs, ...kids){
  const n = document.createElement(tag);
  if (attrs) for (const [k,v] of Object.entries(attrs)) {
    if (k === "class") n.className = v;
    else if (k === "text") n.textContent = v;
    else if (k.startsWith("on")) n.addEventListener(k.slice(2), v);
    else if (v !== false && v != null) n.setAttribute(k, v === true ? "" : v);
  }
  for (const c of kids.flat()) if (c != null) n.append(c.nodeType ? c : document.createTextNode(c));
  return n;
}
function clear(){ app.replaceChildren(); window.scrollTo(0,0); }

/* ---------- Welcome ---------- */
function renderWelcome(){
  clear();
  app.append(el("div",{class:"panel"},
    el("div",{class:"hero-paw","aria-hidden":"true"},"🐾"),
    el("h1",{text:"帶毛孩回家前，花 5 分鐘確認你們合不合拍"}),
    el("p",{text:"回答 6 組簡單問題，AI 會根據你的生活條件，指出需要先準備的地方，並幫你整理第一年的準備清單與花費。"}),
    el("ul",{class:"promises"},
      el("li",{}, el("b",{text:"適配評估　"}), "看看時間、空間、預算與家人是否準備好了"),
      el("li",{}, el("b",{text:"準備清單　"}), "依毛孩年齡與你的居住條件，列出要準備的品類"),
      el("li",{}, el("b",{text:"關懷陪伴　"}), "帶回家後第 7、30、90 天，主動問候與提供協助")
    ),
    el("p",{class:"notice",text:"這是公開示範版：評估結果由內建規則計算。正式版由 AI 依品種特性判讀並解讀飼主回覆，請參考 Demo 影片。"}),
    el("button",{class:"btn",onclick:()=>{step=0;renderStep();}},"開始評估"),
    el("p",{class:"foot",text:"評估結果是幫你做準備，不是審查。不需要填寫姓名或電話。"})
  ));
}

/* ---------- Questionnaire ---------- */
function stepDone(s){
  return STEPS[s].fields.every(f => f.type==="text" || (f.type==="multi" ? (A[f.k]||[]).length>0 : !!A[f.k]));
}
function renderStep(){
  clear();
  const S = STEPS[step];
  const panel = el("div",{class:"panel"},
    el("div",{class:"stepno",text:`第 ${step+1} 步，共 ${STEPS.length} 步`}),
    el("div",{class:"progress",role:"progressbar","aria-valuemin":"0","aria-valuemax":String(STEPS.length),"aria-valuenow":String(step+1)}, el("span",{style:`width:${(step+1)/STEPS.length*100}%`})),
    el("h2",{text:S.title}),
    el("p",{class:"muted",text:S.hint})
  );
  const next = el("button",{class:"btn",onclick:()=>{ if(step<STEPS.length-1){step++;renderStep();} else evaluate(); }}, step<STEPS.length-1 ? "下一步" : "看評估結果");
  const refresh = () => { next.disabled = !stepDone(step); };
  for (const f of S.fields){
    const wrap = el("div",{class:"field"});
    if (f.type === "text"){
      const id = "f_"+f.k;
      const inp = el("input",{type:"text",id,placeholder:f.ph||"",maxlength:"30",value:A[f.k]||""});
      inp.addEventListener("input",()=>{A[f.k]=inp.value.trim();});
      wrap.append(el("label",{for:id,text:f.label}), inp);
    } else {
      const chips = el("div",{class:"chips",role:"group","aria-label":f.label});
      const paint = () => chips.querySelectorAll(".chip").forEach(c=>{
        const on = f.type==="multi" ? (A[f.k]||[]).includes(c.dataset.v) : A[f.k]===c.dataset.v;
        c.setAttribute("aria-pressed", on ? "true" : "false");
      });
      for (const o of f.opts){
        const c = el("button",{type:"button",class:"chip","data-v":o,"aria-pressed":"false"},o);
        c.addEventListener("click",()=>{
          if (f.type==="single") A[f.k]=o;
          else {
            let cur = A[f.k] ? A[f.k].slice() : [];
            if (cur.includes(o)) cur = cur.filter(x=>x!==o);
            else if (f.excl && f.excl.includes(o)) cur = [o];
            else { cur = cur.filter(x=>!(f.excl||[]).includes(x)); cur.push(o); }
            A[f.k]=cur;
          }
          paint(); refresh();
        });
        chips.append(c);
      }
      paint();
      wrap.append(el("span",{class:"lab",text:f.label}), chips);
    }
    panel.append(wrap);
  }
  const back = el("button",{class:"btn ghost",onclick:()=>{ if(step>0){step--;renderStep();} else renderWelcome(); }},"上一步");
  panel.append(el("div",{class:"row nav"}, back, next));
  refresh();
  app.append(panel);
}

/* ---------- Rule engine (always computed; also the fallback) ---------- */
const clamp = (v,a,b)=>Math.max(a,Math.min(b,Math.round(v)));
function levelOf(s){ return s>=75 ? "低風險" : s>=55 ? "中風險" : "高風險"; }
function ruleEval(a){
  const dog = a.species==="狗", young = (a.age||"").startsWith("幼年"), senior=(a.age||"").startsWith("高齡");
  let t = {"不到 1 小時":40,"1–3 小時":75,"3 小時以上":95}[a.companion] ?? 60;
  let awayPen = {"6 小時以內":0,"6–10 小時":10,"10 小時以上":25}[a.away] ?? 0;
  if (!dog) awayPen = Math.round(awayPen/2);
  if (young && a.away==="10 小時以上") awayPen += 10;
  t -= awayPen;
  let l = {"租屋":80,"自有住宅":95,"與家人同住":88}[a.housing] ?? 80;
  if (a.landlord==="還沒確認") l -= 30;
  if (dog && a.space==="套房") l -= 15;
  let m = {"2,000 元以下":45,"2,000–4,000 元":75,"4,000 元以上":92}[a.monthly] ?? 60;
  if (a.emergency==="還沒有") m -= 20;
  if (senior) m -= 10;
  let f = 95;
  if (a.consent==="還有人不確定") f -= 35;
  if (a.allergy==="有") f -= 40; else if (a.allergy==="不確定") f -= 15;
  if ((a.members||[]).includes("幼兒") && dog) f -= 5;
  let e = 90;
  if (a.experience==="第一次養") e -= 15;
  e -= 15 * (a.changes||[]).filter(x=>x!=="都沒有").length;
  const scores = [t,l,m,f,e].map(v=>clamp(v,20,100));
  const score = clamp(scores.reduce((s,v)=>s+v,0)/scores.length,0,100);
  const comments = [
